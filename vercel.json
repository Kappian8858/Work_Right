{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://prompt-wars-vsi5.onrender.com/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/passport/(.*)",
      "dest": "https://prompt-wars-vsi5.onrender.com/passport/$1"
    },
    {
      "src": "/worker(.*)",
      "dest": "/public/worker$1"
    },
    {
      "src": "/admin(.*)",
      "dest": "/public/admin$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}

